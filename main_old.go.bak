// lazyComputeSizes computes sizes for up to limit apps, then refreshes UI once.
func lazyComputeSizes(serial string, list []*AndroidApp, limit int) {
	count := 0
	sem := make(chan struct{}, 6)
	updated := false
	for _, a := range list {
		if a.SizeKB > 0 {
			continue
		}
		if count >= limit {
			break
		}
		count++
		sem <- struct{}{}
		go func(app *AndroidApp) {
			defer func() { <-sem }()
			if appDetector.EnsureSizeFor(serial, app) {
				updated = true
			}
		}(a)
	}
	for i := 0; i < cap(sem); i++ {
		sem <- struct{}{}
	}
	if updated {
		fyne.Do(func() { updateAppGrid() })
	}
}

func onDevicesChanged(newDevices []*Device) {
	devices = newDevices
	fyne.Do(func() {
		if deviceList != nil {
			deviceList.Refresh()
		}
	})
}

func onRunningAppsChanged(ra []*RunningApp) {
	runningApps = ra
	fyne.Do(func() {
		if runningAppsList != nil {
			runningAppsList.Refresh()
		}
	})
}

func updateStatus(message string) {
	fmt.Println("[STATUS]", message)
	fyne.Do(func() {
		if statusLabel != nil {
			statusLabel.SetText(message)
		}
	})
}
